// Cloudflare Workers config: this is an assets-only Worker that serves the static Next.js export.
// Reason: the site has no server code, so Workers Static Assets (free, unlimited requests) is all we need.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neil-hutcheon-bio",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    // Serve Next's exported 404.html for unknown paths instead of a blank response.
    "not_found_handling": "404-page",
    // Lets /about resolve to /about.html if more routes are ever exported.
    "html_handling": "auto-trailing-slash"
  }
}
